  },
  "agent_command": [
    "provider-adapter",
    "--cwd",
    "{cwd}",
    "--prompt-file",
    "{prompt_file}",
    "--model",
    "{model}",
    "--effort",
    "{effort}",
    "--runner-receipt",
    "{runner_receipt}"
  ],
  "require_served_identity": true,
  "arms": {
    "OLD": {
      "provider": "configured-provider",
      "model": "served-model-id",
